# ============================================================
# SupplyGuard 环境变量模板 (.env.example)
#
# 使用方式:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 按需编辑后, 通过 export / $env: 注入当前会话
#      (本项目代码当前不自动加载 .env 文件, 需手动 export,
#       详见 delivery/README.md 第 8 节「环境变量说明」)
#   3. 本文件为模板, 不含真实密钥; 真实密钥请勿提交进仓库
#      (在 .gitignore 中排除 .env)
# ============================================================

# ------------------------------------------------------------
# LLM 解释层 (analysis/llm_explainer.py 实际读取)
# - 不配置 SUPPLYGUARD_LLM_URL 时: 使用本地模板解释 (零依赖)
# - 配置后: 调用 OpenAI 兼容接口; 网络/鉴权失败一律降级
#   status=unavailable, 不影响 T1~T5 判定结论
# ------------------------------------------------------------
# 远程 LLM 网关地址 (OpenAI 兼容 chat/completions), 留空 = 本地模板
SUPPLYGUARD_LLM_URL=
# 远程 LLM API Key (示例格式, 勿填真实密钥)
SUPPLYGUARD_LLM_API_KEY=sk-your-api-key-here
# 远程 LLM 模型名 (默认 gpt-4o-mini)
SUPPLYGUARD_LLM_MODEL=gpt-4o-mini
# 故障注入开关: 1 = 强制禁用 LLM (降级专项回归测试用), 默认 0/留空
SUPPLYGUARD_LLM_DISABLED=0

# ------------------------------------------------------------
# MQTT (模板变量; 当前代码使用默认常量 127.0.0.1:1883,
# 见 backend/mqtt_client.py BROKER/PORT)
# ------------------------------------------------------------
# MQTT broker 地址 (如本机 mosquitto)
SUPPLYGUARD_MQTT_BROKER=127.0.0.1
# MQTT broker 端口 (默认 1883)
SUPPLYGUARD_MQTT_PORT=1883

# ------------------------------------------------------------
# 后端服务 (模板变量; 端口由 uvicorn 启动参数控制,
# 如: uvicorn main:app --host 0.0.0.0 --port 8000)
# ------------------------------------------------------------
# 后端监听地址 (默认 127.0.0.1 本机演示)
SUPPLYGUARD_API_HOST=127.0.0.1
# 后端端口 (默认 8000, console 前端与小程序按此地址访问)
SUPPLYGUARD_API_PORT=8000

# ------------------------------------------------------------
# 数据库 (模板变量; 当前代码默认 backend/bb03.db,
# 见 backend/db.py DB_PATH; 回归测试在代码层重定向临时库)
# ------------------------------------------------------------
# SQLite 数据库文件路径
SUPPLYGUARD_DB_PATH=backend/bb03.db
